{
  "uid": "popularity",
  "title": "store",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "current": { "selected": true, "text": "prod", "value": "prod" },
        "options": [
          { "selected": false, "text": "uat", "value": "uat" },
          { "selected": true, "text": "prod", "value": "prod" }
        ],
        "query": "uat,prod",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "arch",
        "label": "Architecture",
        "type": "custom",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "amd64", "value": "amd64" },
          { "selected": false, "text": "arm64", "value": "arm64" },
          { "selected": false, "text": "armhf", "value": "armhf" }
        ],
        "query": "amd64,arm64,armhf",
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "table",
      "title": "Apps in use (by refresh)",
      "description": "Devices refresh every installed snap about once a day, so refresh count per app over 24h is a census of what is installed across the fleet. Pinned to 24h so the dashboard time picker cannot shrink it below one refresh cycle. Installs are excluded on purpose: CI installs from the production store, so install counts are not usage.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 12 },
      "timeFrom": "24h",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (snap) (increase(store_snapd_request_total{env=\"$env\",arch=~\"$arch\",snap!=\"\",action=\"refresh\"}[$__range]))", "refId": "A", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "snap": "app", "Value": "refreshes" } } }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false },
        "sortBy": [ { "displayName": "refreshes", "desc": true } ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "width": 60 },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "app" },
            "properties": [
              { "id": "custom.width", "value": 180 }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Snapd request rate (per minute, by action)",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (action) (rate(store_snapd_request_total{env=\"$env\",arch=~\"$arch\"}[1m])) * 60", "refId": "A", "legendFormat": "{{action}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "pointSize": 5, "showPoints": "auto" },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Refresh requests per arch (last 24h)",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (arch) (increase(store_snapd_request_total{action=\"refresh\",env=\"$env\",arch=~\"$arch\"}[24h]))", "refId": "A", "legendFormat": "{{arch}}", "instant": true }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] },
          "decimals": 0
        }
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Requests per status (last 24h)",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (status) (increase(store_snapd_request_total{env=\"$env\",arch=~\"$arch\"}[24h]))", "refId": "A", "legendFormat": "{{status}}", "instant": true }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-RdYlGr" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] },
          "decimals": 0
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Trending apps (rolling 24h refresh per app)",
      "description": "Refresh only. Installs are excluded because CI installs from the production store and would read as popularity.",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 12 },
      "timeFrom": "7d",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "topk(10, sum by (snap) (increase(store_snapd_request_total{action=\"refresh\",env=\"$env\",arch=~\"$arch\",snap!=\"\"}[24h])))", "refId": "A", "legendFormat": "{{snap}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "pointSize": 5, "showPoints": "auto" },
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
