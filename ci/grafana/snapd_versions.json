{
  "uid": "snapd-versions",
  "title": "snapd client versions",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "current": { "selected": true, "text": "prod", "value": "prod" },
        "options": [
          { "selected": false, "text": "uat", "value": "uat" },
          { "selected": true, "text": "prod", "value": "prod" }
        ],
        "query": "uat,prod",
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "snapd scheduled refreshes by version, 1h window ($env)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (version) (increase(store_snapd_scheduled_refresh_total{env=\"$env\"}[1h]))", "refId": "A", "legendFormat": "{{version}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "stacking": { "mode": "normal", "group": "A" }, "fillOpacity": 100, "lineWidth": 0, "barAlignment": 0 }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Devices by snapd version (last 24h, one scheduled refresh per device)",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (version) (increase(store_snapd_scheduled_refresh_total{env=\"$env\"}[24h]))", "refId": "A", "legendFormat": "{{version}}", "instant": true }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] },
          "decimals": 0
        }
      }
    }
  ]
}
